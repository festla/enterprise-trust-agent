def test_reject_registry_yaml_with_non_mapping_root(
    tmp_path: Path,
) -> None:
    """Registry YAML 顶层不是映射对象时应失败。"""

    yaml_path = tmp_path / "invalid_registry.yaml"

    yaml_path.write_text(
        "- first_item\n- second_item\n",
        encoding="utf-8",
    )

    with pytest.raises(
        RegistryLoaderError,
        match="顶层必须是映射对象",
    ):
        load_registry_yaml(yaml_path)



